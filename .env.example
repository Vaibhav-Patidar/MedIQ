# ============================================================
#  MedIQ environment — REQUIRED + commonly used values only.
#  Every variable below is documented in WHERE_TO_FIND_ENV_VALUES.md
#  (where to get it, which service consumes it, required vs optional).
# ============================================================

# --- PostgreSQL (source of truth) — required ---
POSTGRES_DB=mediq
POSTGRES_USER=mediq
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://mediq:change-me-local-only@postgres:5432/mediq

# --- Neo4j (ontology graph) — required; keep AUTH and PASSWORD in sync ---
NEO4J_AUTH=neo4j/change-me-local-only
NEO4J_PASSWORD=change-me-local-only

# --- Auth signing secret (local flow) — required ---
JWT_SECRET=fd8fb664a7fb7fa50cb71ac8728687c729dbba29d6bdbaf28f247f3737592cd6

# --- Ontology backend: 'neo4j' (default) or 'postgres_fk' (ADR-002) ---
ONTOLOGY_BACKEND=neo4j

# --- Supabase (OPTIONAL managed Postgres + auth; leave blank to run offline) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- Demo login created by `python seed_data.py` ---
SEED_CLINICIAN_PASSWORD=mediq-demo

# ------------------------------------------------------------
# Everything else (inference tuning, MRI limits, CORS, log level,
# VITE_* frontend vars…) has sane defaults in backend/app/core/config.py
# and does NOT need to be set. Optional overrides:
#
# NEO4J_URL=bolt://neo4j:7687
# NEO4J_USER=neo4j
# JWT_EXPIRES_IN=3600
# MIN_INFERENCE_HOURS=2
# WINDOW_DURATION_HOURS=4
# TRAJECTORY_HOURS=6
# SEPSIS_CHECKPOINT_PATH=/app/checkpoints/sepsis_xgboost.pkl
# MRI_UPLOAD_DIR=/data/uploads
# MRI_MAX_UPLOAD_MB=200
# SEED_CLINICIAN_EMAIL=doctor@mediq.local
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LOG_LEVEL=INFO
# ------------------------------------------------------------
