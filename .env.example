# ============================================================
#  MedIQ environment — REQUIRED values only.
#  Every variable is documented in WHERE_TO_FIND_ENV_VALUES.md
#  (exact dashboard locations for the Supabase ones).
# ============================================================

# --- Supabase (source of truth: Postgres DB + auth) — required ---
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon / publishable key>
# legacy HS256 projects only; blank = verify via JWKS
SUPABASE_JWT_SECRET=

# --- Neo4j (ontology graph, self-hosted docker) — keep AUTH/PASSWORD in sync ---
NEO4J_AUTH=neo4j/change-me-local-only
NEO4J_PASSWORD=change-me-local-only

# --- Auth signing secret (local-flow fallback only) ---
JWT_SECRET=<generate: python -c "import secrets; print(secrets.token_hex(32))">

# --- Ontology backend: 'neo4j' (default) or 'postgres_fk' (ADR-002) ---
ONTOLOGY_BACKEND=neo4j

# --- Demo login created in Supabase Auth dashboard ---
SEED_CLINICIAN_PASSWORD=mediq-demo

# ------------------------------------------------------------
# Optional overrides (defaults in backend/app/core/config.py):
# NEO4J_URL=bolt://neo4j:7687
# NEO4J_USER=neo4j
# JWT_EXPIRES_IN=3600
# MIN_INFERENCE_HOURS=2
# WINDOW_DURATION_HOURS=4
# TRAJECTORY_HOURS=6
# SEPSIS_CHECKPOINT_PATH=/app/checkpoints/sepsis_xgboost.pkl
# MRI_UPLOAD_DIR=/data/uploads
# MRI_MAX_UPLOAD_MB=200
# SEED_CLINICIAN_EMAIL=doctor@mediq.local
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LOG_LEVEL=INFO
# ------------------------------------------------------------
