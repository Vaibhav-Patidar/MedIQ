# MedIQ local demo environment — copy to .env and fill in real secrets.
# See docs/10-deployment-spec.md Section 1.3. NEVER commit .env.

# --- PostgreSQL ---
POSTGRES_DB=mediq
POSTGRES_USER=mediq
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://mediq:change-me-local-only@postgres:5432/mediq

# --- Neo4j ---
NEO4J_AUTH=neo4j/change-me-local-only
NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local-only

# --- Auth ---
# Generate once per environment: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-random-256-bit-hex
JWT_EXPIRES_IN=3600

# --- Supabase (managed Postgres + hosted auth) — optional but recommended ---
# 1. Create a project at https://supabase.com
# 2. Database: copy the connection string (Session mode, port 5432) into
#    DATABASE_URL below, then apply the schema:
#      docker compose exec backend python apply_supabase_schema.py
# 3. Auth: create the demo clinician (Authentication → Users → Add user):
#      doctor@mediq.local / mediq-demo
# 4. Fill these in from Project Settings → API:
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Legacy projects only (HS256 signing secret). Newer projects use asymmetric
# keys — leave blank and the backend verifies via the project JWKS endpoint.
SUPABASE_JWT_SECRET=
# When SUPABASE_URL is empty the backend falls back to built-in local JWT auth
# and the dockerized postgres — zero-cloud offline demo still works.

# --- Ontology backend (ADR-002): 'neo4j' (default) or 'postgres_fk' fallback ---
ONTOLOGY_BACKEND=neo4j

# --- Sepsis prediction tuning ---
MIN_INFERENCE_HOURS=2
WINDOW_DURATION_HOURS=4
TRAJECTORY_HOURS=6

# --- Trained model (loaded at startup; falls back to the deterministic
# surrogate if the file is missing) ---
SEPSIS_CHECKPOINT_PATH=/app/checkpoints/sepsis_xgboost.pkl

# --- MRI uploads (stretch stub) ---
MRI_UPLOAD_DIR=/data/uploads
MRI_MAX_UPLOAD_MB=200

# --- Seeded login (demo only) ---
SEED_CLINICIAN_EMAIL=doctor@mediq.local
SEED_CLINICIAN_PASSWORD=mediq-demo

# --- CORS / misc ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- Frontend (placeholder scaffold; unused by backend) ---
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000/ws

# --- Compose healthcheck password plumbing (do not override casually) ---
HEALTHCHECK_POSTGRES_PASSWORD=change-me-local-only
